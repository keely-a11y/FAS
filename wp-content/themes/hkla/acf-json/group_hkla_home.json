{
    "key": "group_hkla_home",
    "title": "Home page",
    "fields": [
        {
            "key": "field_hkla_home_hero_image",
            "label": "Hero image",
            "name": "hero_image",
            "type": "image",
            "instructions": "Minimum width 2400px. A featured project photograph.",
            "required": 1,
            "return_format": "array",
            "preview_size": "medium",
            "min_width": 2400
        },
        {
            "key": "field_hkla_home_hero_slides",
            "label": "Hero slides",
            "name": "hero_slides",
            "type": "gallery",
            "instructions": "1 to 5 images. More than one renders the slow crossfade slideshow.",
            "min": 0,
            "max": 5,
            "return_format": "array",
            "preview_size": "medium"
        },
        {
            "key": "field_hkla_home_hero_video",
            "label": "Hero video (optional)",
            "name": "hero_video",
            "type": "url",
            "instructions": "Optional self-hosted MP4. The hero image becomes the poster."
        },
        {
            "key": "field_hkla_home_hero_line",
            "label": "Hero line",
            "name": "hero_line",
            "type": "text",
            "default_value": "Shared spaces. Shared stories."
        },
        {
            "key": "field_hkla_home_mission",
            "label": "Intro copy",
            "name": "mission_statement",
            "type": "textarea",
            "rows": 4,
            "default_value": "HKLA is a civic landscape specialist. Grounded in storytelling and a commitment to community, we shape environments for a shared and sustainable future.",
            "instructions": "2 to 3 lines under the hero."
        },
        {
            "key": "field_hkla_home_featured",
            "label": "Featured projects",
            "name": "featured_projects",
            "type": "relationship",
            "instructions": "Choose 3 or 4 projects for the front page.",
            "post_type": [
                "project"
            ],
            "filters": [
                "search",
                "taxonomy"
            ],
            "min": 3,
            "max": 4,
            "return_format": "object"
        }
    ],
    "location": [
        [
            {
                "param": "page_type",
                "operator": "==",
                "value": "front_page"
            }
        ]
    ],
    "menu_order": 0,
    "position": "acf_after_title",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true,
    "show_in_rest": 0
}