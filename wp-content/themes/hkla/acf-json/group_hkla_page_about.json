            "tabs": "visual",
            "toolbar": "hkla_minimal",
            "media_upload": 0
        },
        {
            "key": "field_hkla_about_belief",
            "label": "Belief statement",
            "name": "belief_statement",
            "type": "textarea",
            "rows": 3,
            "instructions": "The big ink-band statement. One or two sentences.",
            "default_value": "Urban open space is the pinnacle of democratic practice. Everyone, regardless of origin, color, religion, or interest, can be there together."
        },
        {
            "key": "field_hkla_about_principles",
            "label": "Three principles",
