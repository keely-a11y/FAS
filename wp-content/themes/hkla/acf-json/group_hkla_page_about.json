                    "return_format": "array",
                    "preview_size": "medium"
                },
                {
                    "key": "field_hkla_about_principle_title",
                    "label": "Title",
                    "name": "title",
                    "type": "text",
                    "required": 1
                },
                {
                    "key": "field_hkla_about_principle_body",
                    "label": "Body",
                    "name": "body",
                    "type": "wysiwyg",
                    "tabs": "visual",
                    "toolbar": "hkla_minimal",
                    "media_upload": 0
                }
            ]
        },
        {
            "key": "field_hkla_about_founder_name",
            "label": "Founder: name",
            "name": "founder_name",
            "type": "text",
