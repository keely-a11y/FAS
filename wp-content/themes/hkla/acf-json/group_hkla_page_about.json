{
    "key": "group_hkla_page_about",
    "title": "About page",
    "fields": [
        {
            "key": "field_hkla_about_framing",
            "label": "Framing statement",
            "name": "framing_statement",
            "type": "text",
            "default_value": "Harmony between people and nature."
        },
        {
            "key": "field_hkla_about_approach",
            "label": "Approach",
            "name": "approach_body",
            "type": "wysiwyg",
