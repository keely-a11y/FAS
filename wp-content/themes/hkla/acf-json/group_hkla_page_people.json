{
    "key": "group_hkla_page_people",
    "title": "People page",
    "fields": [
        {
            "key": "field_hkla_people_framing",
            "label": "Framing statement",
            "name": "framing_statement",
            "type": "text",
            "default_value": "The people behind the places."
        },
        {
            "key": "field_hkla_people_founder_name",
            "label": "Founder: name",
            "name": "founder_name",
            "type": "text",
            "default_value": "Hongjoo Kim"
        },
        {
            "key": "field_hkla_people_founder_title",
            "label": "Founder: title",
            "name": "founder_title",
            "type": "text",
            "default_value": "Founding Principal"
        },
        {
            "key": "field_hkla_people_founder_bio",
            "label": "Founder: bio",
            "name": "founder_bio",
            "type": "wysiwyg",
            "tabs": "visual",
            "toolbar": "hkla_minimal",
            "media_upload": 0
        },
        {
            "key": "field_hkla_people_founder_portrait",
            "label": "Founder: portrait",
            "name": "founder_portrait",
            "type": "image",
            "return_format": "array",
            "preview_size": "medium"
        },
        {
            "key": "field_hkla_people_boutique",
            "label": "Boutique statement",
            "name": "boutique_statement",
            "type": "textarea",
            "rows": 3
        },
        {
            "key": "field_hkla_people_recognition",
            "label": "Recognition",
            "name": "recognition",
            "type": "repeater",
            "layout": "table",
            "button_label": "Add item",
            "sub_fields": [
                {
                    "key": "field_hkla_people_recognition_title",
                    "label": "Title",
                    "name": "title",
                    "type": "text",
                    "required": 1
                },
                {
                    "key": "field_hkla_people_recognition_org",
                    "label": "Organization",
                    "name": "organization",
                    "type": "text"
                },
                {
                    "key": "field_hkla_people_recognition_year",
                    "label": "Year",
                    "name": "year",
                    "type": "text"
                }
            ]
        },
        {
            "key": "field_hkla_people_careers_invitation",
            "label": "Careers invitation",
            "name": "careers_invitation",
            "type": "text"
        }
    ],
    "location": [
        [
            {
                "param": "page_template",
                "operator": "==",
                "value": "page-people.php"
            }
        ]
    ],
    "menu_order": 0,
    "position": "acf_after_title",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true,
    "show_in_rest": 0
